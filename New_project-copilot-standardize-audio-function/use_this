find_minima <- function(fun, start)
{
  n <- length(start)
  
  local.minimas <- numeric(n)
  fn.at.minimas <- numeric(n)
  
  for(i in 1:n)
  {
    fit <- optim(par = start[i], fn = fun)
    
    local.minimas[i] <- fit$par
    fn.at.minimas[i] <- fit$value
  }
  
  # index of best (minimum function value)
  ind <- which.min(fn.at.minimas)
  
  # return best argument
  return(local.minimas[ind])
}

